# AI Model Token
HF_TOKEN=

# --- Ses Formatı Sabitleri ---
DEFAULT_RATE=48000
DEFAULT_CHANNELS=2
FRAME_DURATION_MS=30

# --- Çıktı Ayarları ---
OUTPUT_FILENAME=system_recorded.wav

# --- Sessizlik Algılama ---
SILENCE_LIMIT=35
SHORT_SILENCE_LIMIT=10
# Chunk süreleri altyazı sadeliğini doğrudan belirler: chunk ne kadar uzunsa,
# tek bir altyazı satırına o kadar çok cümle sığar (kalabalık görüntü). Gerçek
# altyazı hissi için kısa tutulur. SOFT = "yumuşak" hedef süre; MAX = mutlak
# tavan (bu süreye gelince konuşma sürse bile chunk paketlenir).
# 6000/9000 → 3000/5000'e indirildi (daha kısa segment = daha az kalabalık).
# Çok düşürmek çeviri bağlamını zayıflatır ve diarization/çeviri çağrılarını
# artırır; 3000/5000 dengeli başlangıçtır.
SOFT_CHUNK_DURATION_MS=3000
MAX_CHUNK_DURATION_MS=5000
# Pre-roll: konuşma algılanmadan önceki son N ms ham ses chunk'ın başına
# eklenir (VAD'in kaçırdığı kelime başlangıçları kırpılmaz).
PRE_ROLL_MS=240
# Overlap: max-süre kesmelerinde son N ms sonraki chunk'a taşınır ve orada
# transkripsiyondan kırpılır (kesim noktasındaki kelime kaybolmaz).
CHUNK_OVERLAP_MS=480
# Kısmi (canlı satır) transkripsiyon penceresi: buffer'ın yalnızca SON bu kadar
# ms'i decode edilir. Final transkripsiyon her zaman tam buffer'ı görür.
PARTIAL_WINDOW_MS=4000
# VAD ayarları CHiME-6 taramasının (output/vad_sweep*.csv) optimum bölgesi.
VAD_AGGRESSIVENESS=2
SILERO_THRESHOLD=0.70
# WebRTC ön-filtre katmanı (AND kapısı). Silero her frame'de zaten çalıştığı
# için WebRTC hesaplama tasarrufu sağlamaz; yalnızca kaçırma ekleyip yanlış
# alarmı azaltabilir. Kapatıp A/B ölçmek için: scripts/vad_webrtc_ablation.py
VAD_USE_WEBRTC=true

# --- AI Model Ayarları ---
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# --- Çeviri Motoru ---
# Çeviri motorunu ZORLA. Boş bırakılırsa otomatik öncelik kullanılır:
# DeepL anahtarı > yerel NLLB modeli > Google (yedek).
# Seçenekler: google | deepl | ctranslate2
# Google'ı kullanmak için: TRANSLATION_ENGINE=google
TRANSLATION_ENGINE=

# --- Whisper Ayarları ---
WHISPER_LANGUAGE=en
# Whisper modeli: models/ altındaki dizin adı (veya mutlak yol). Boş bırakılırsa
# GPU'da whisper-medium (varsa), aksi halde whisper-small kullanılır.
WHISPER_MODEL=whisper-small
# Ana ses dosyasını kaydetmek için true yapın
SAVE_AUDIO_FILE=False

# --- Diarization Ayarları ---
# Konuşmacı eşleştirme eşiği (0.0 - 1.0) — ANA AYAR KNOBU.
# Belirsizlik bandı kaldırıldıktan sonra bu, eşleşme ile yeni-aday arasındaki
# TEK kesim noktası. DÜŞÜK eşik → daha çok ses baskın konuşmacıya yapışır
# (over-collapse, AMI'deki kusur). YÜKSEK eşik → aynı konuşmacı bölünebilir
# (over-segmentation). 0.66 dengeli başlangıç; AMI/score.py ile kalibre et:
# DER "confusion" yüksekse ↑, konuşmacı sayısı şişiyorsa ↓.
DIARIZATION_EMBEDDING_THRESHOLD=0.66
# Warm-up süresi (ms) — ilk bu kadar süre embedding toplanır ve konuşmacı
# sayısı belirlenir. UZUN warm-up, başta fazla/gürültülü konuşmacı kümeleyip
# bu sayıyı kalıcı kilitleme riskini artırır. 45sn→20sn'ye indirildi; ayrıca
# _merge_similar_speakers şişen sayıyı sonradan da düzeltir.
DIARIZATION_WARMUP_MS=20000

# --- Konuşmacı Takip Ayarları (Aday Tamponu) ---
# Yeni bir konuşmacı oluşturulmadan önce gereken minimum gözlem sayısı
CANDIDATE_CONFIRMATIONS_NEEDED=2
# Onaylanmayan aday konuşmacıların silinmeden önce bekletileceği döngü (chunk) sayısı
CANDIDATE_TTL=15
# Aday seslerin kendi aralarındaki minimum kosinüs benzerliği eşiği (0.0 - 1.0)
# 0.60 fazla gevşekti: farklı kişilerin kısa/gürültülü embedding'leri birleşip
# tek bir hayalet konuşmacı oluşturabiliyordu. 0.78'e yükseltildi.
CANDIDATE_SELF_SIMILARITY=0.78
# Yeni konuşmacı oluşturabilmek için gereken minimum temiz konuşma süresi (sn).
# Kısa sesler ("evet", "aynen öyle") asla yeni konuşmacı yaratamaz;
# en yakın mevcut konuşmacıya atanır.
MIN_NEW_SPEAKER_DURATION=2.0